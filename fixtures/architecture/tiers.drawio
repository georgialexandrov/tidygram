<mxfile host="puml-layout">
  <diagram id="tiers" name="Tiers">
    <mxGraphModel grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="user" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="web" value="Web tier" style="swimlane;html=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="spa" value="Shop SPA" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="web">
          <mxGeometry x="20" y="50" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bff" value="BFF API" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="web">
          <mxGeometry x="260" y="50" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="Services" style="swimlane;html=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="orders" value="Ordering" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="svc">
          <mxGeometry x="20" y="50" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="billing" value="Billing" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="svc">
          <mxGeometry x="260" y="50" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="data" value="Data" style="swimlane;html=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Orders DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;" vertex="1" parent="data">
          <mxGeometry x="20" y="45" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="Ledger" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;" vertex="1" parent="data">
          <mxGeometry x="260" y="45" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="psp" value="Payment provider" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="210" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="user" target="spa"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="spa" target="bff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="bff" target="orders"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="orders" target="billing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="orders" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="billing" target="ledger"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="billing" target="psp"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
